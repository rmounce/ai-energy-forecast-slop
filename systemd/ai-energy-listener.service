[Unit]
Description=Event-driven predict-price refresh on Amber APF state change
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/ai-energy-forecast-slop
EnvironmentFile=%h/src/ai-energy-forecast-slop/.env
ExecStart=%h/src/ai-energy-forecast-slop/.venv/bin/python %h/src/ai-energy-forecast-slop/services/ha_listener.py
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

[Install]
WantedBy=default.target
