[Unit]
Description=Update tariff profile, backfill actuals, and update covariate adjusters

[Service]
Type=oneshot
Nice=19
WorkingDirectory=%h/src/ai-energy-forecast-slop
ExecStart=/bin/bash -c 'source .venv/bin/activate && ./forecast.py update-tariffs && ./forecast.py backfill-actuals && ./forecast.py update-adjusters'
