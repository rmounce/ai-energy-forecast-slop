[Unit]
Description=Report aggregate repository job health to Healthchecks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/ai-energy-forecast-slop
EnvironmentFile=%h/src/ai-energy-forecast-slop/.env
ExecStart=%h/src/ai-energy-forecast-slop/.venv/bin/python %h/src/ai-energy-forecast-slop/healthchecks.py aggregate
TimeoutStartSec=30sec
