[Service]
User=energy-user
Type=oneshot
WorkingDirectory=%h/src/ai-energy-forecast-slop
EnvironmentFile=%h/src/ai-energy-forecast-slop/.env
ExecStart=/bin/bash -c 'source .venv/bin/activate && ./forecast.py predict-all --dynamic-handoff --publish-hass --publish-covariates && curl -fsS --retry 3 ${HC_PREDICT_URL}'
